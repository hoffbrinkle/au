load("@rules_cc//cc:defs.bzl", "cc_library")

# Au's consumers load this package whenever one of their targets refers to a file in it, so it may
# only load rules they are guaranteed to have: native rules, and `rules_cc`.  Anything that needs a
# `dev_dependency` (`rules_python`, `rules_shell`, our pip hub, etc.) belongs in another package,
# such as`//tools/docs` or `//release`.

# The README quotes code from `//examples`, and `//examples:readme_snippets_test` checks that those
# copies still match their source.
exports_files(["README.md"])

exports_files(
    [
        "requirements.in",
        "requirements_lock.txt",
    ],
    visibility = ["//tools/docs:__pkg__"],
)

# The doc website's sources.  This allows us a glob from the root of the
# workspace.
filegroup(
    name = "doc_site_sources",
    srcs = ["mkdocs.yml"] + glob([
        "docs/**",
        "doc_snippets/**",
    ]),
    visibility = ["//tools/docs:__pkg__"],
)

BASE_UNITS = [
    "meters",
    "seconds",
    "grams",
    "kelvins",
    "amperes",
    "moles",
    "candelas",
    "radians",
    "bits",
    "unos",
]

BASE_UNIT_STRING = " ".join(BASE_UNITS)

GIT_ID_CMD = "cat bazel-out/stable-status.txt | grep STABLE_GIT_ID | sed 's/STABLE_GIT_ID \\(.*\\)/\\1/' | tr -d '\\n'"

CMD_ROOT = "$(location tools/bin/make-single-file) {extra_opts} {units} {all_literals} {all_constants} --version-id $$({id_cmd}) > $(OUTS)"

################################################################################
# Release single-file package `au.hh`

genrule(
    name = "au_hh",
    srcs = ["//au:headers"],
    outs = ["docs/au.hh"],
    cmd = CMD_ROOT.format(
        all_constants = "",
        all_literals = "",
        extra_opts = "",
        id_cmd = GIT_ID_CMD,
        units = "--units " + BASE_UNIT_STRING,
    ),
    stamp = True,
    tools = ["tools/bin/make-single-file"],
    visibility = [
        "//release:__pkg__",
        "//tools/docs:__pkg__",
    ],
)

cc_library(
    name = "au_hh_lib",
    hdrs = ["docs/au.hh"],
    visibility = ["//release:__pkg__"],
)

