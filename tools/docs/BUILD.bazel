"""
Tooling for the doc website.
"""

load("@au_pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# This rule adds a convenient way to update the requirements file.
compile_pip_requirements(
    name = "requirements",
    requirements_in = "//:requirements.in",
    requirements_txt = "//:requirements_lock.txt",
)

# Both binaries run from the root of their runfiles, which is where `mkdocs` looks for
# `mkdocs.yml`; that is why the doc sources stay in the root package.
py_binary(
    name = "update_docs",
    srcs = ["update_docs.py"],
    data = [
        "//:au_all_units_hh",
        "//:au_all_units_noio_hh",
        "//:au_all_units_stdformat_hh",
        "//:au_all_units_stdformat_noio_hh",
        "//:au_hh",
        "//:au_noio_hh",
        "//:au_stdformat_hh",
        "//:au_stdformat_noio_hh",
        "//:doc_site_sources",
        "//examples:doc_sources",
    ],
    deps = [
        requirement("mkdocs"),
        requirement("mkdocs-material"),
    ],
)

py_binary(
    name = "mike",
    srcs = ["mike_bin.py"],
    data = [
        "//:au_all_units_hh",
        "//:au_all_units_noio_hh",
        "//:au_all_units_stdformat_hh",
        "//:au_all_units_stdformat_noio_hh",
        "//:au_hh",
        "//:au_noio_hh",
        "//:au_stdformat_hh",
        "//:au_stdformat_noio_hh",
        "//:doc_site_sources",
    ],
    main = "mike_bin.py",
    deps = [
        ":update_docs",
        requirement("mike"),
        requirement("mkdocs"),
        requirement("mkdocs-material"),
    ],
)
