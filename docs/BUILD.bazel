"""
The doc website's sources, and the single-file packages published on it.

`mkdocs` builds `docs/` into the site (it is the default `docs_dir`), which is why the
single-file packages are generated here: they are served from the site root, and `docs/install.md`
links to them as `../au.hh` and so on.
"""

BASE_UNITS = [
    "meters",
    "seconds",
    "grams",
    "kelvins",
    "amperes",
    "moles",
    "candelas",
    "radians",
    "bits",
    "unos",
]

BASE_UNIT_STRING = " ".join(BASE_UNITS)

GIT_ID_CMD = "cat bazel-out/stable-status.txt | grep STABLE_GIT_ID | sed 's/STABLE_GIT_ID \\(.*\\)/\\1/' | tr -d '\\n'"

CMD_ROOT = "$(location //:tools/bin/make-single-file) {extra_opts} {units} {all_literals} {all_constants} --version-id $$({id_cmd}) > $(OUTS)"

################################################################################
# Release single-file package `au.hh`

genrule(
    name = "au_hh",
    srcs = ["//au:headers"],
    outs = ["au.hh"],
    cmd = CMD_ROOT.format(
        all_constants = "",
        all_literals = "",
        extra_opts = "",
        id_cmd = GIT_ID_CMD,
        units = "--units " + BASE_UNIT_STRING,
    ),
    stamp = True,
    tools = ["//:tools/bin/make-single-file"],
    visibility = [
        "//release:__pkg__",
        "//tools/docs:__pkg__",
    ],
)

cc_library(
    name = "au_hh_lib",
    hdrs = ["au.hh"],
    visibility = ["//release:__pkg__"],
)

