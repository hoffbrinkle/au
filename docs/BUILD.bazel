################################################################################
# The doc website's sources, for `//tools/docs`, which can't glob them from there.

# Glob what we need while avoiding a recursive glob.
filegroup(
    name = "doc_sources",
    srcs = glob([
        "*.css",
        "*.md",
        "alternatives/*.md",
        "assets/*",
        "discussion/*.md",
        "discussion/concepts/*.md",
        "discussion/idioms/*.md",
        "discussion/implementation/*.md",
        "examples/*.md",
        "howto/*.md",
        "howto/interop/*.md",
        "reference/*.md",
        "reference/detail/*.md",
        "tutorial/*.md",
        "tutorial/exercise/*.md",
    ]),
    visibility = ["//tools/docs:__pkg__"],
)
